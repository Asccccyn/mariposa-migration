{
  "schema_format": "JSON Schema Draft 2020-12 per entry",
  "version": "1.0",
  "project": "mariposa",
  "scope": "Tool arguments only. Actor, binding and transport metadata are not accepted arguments.",
  "runtime_constraints": [
    "Cross-field dates and ranges must be validated by the domain handler.",
    "For forget_proposal require memory_id and expected_memory_version.",
    "quote reconciliation is a server-controlled job, not a generic tool privilege.",
    "Supplied role, actor, approval booleans, include_old_body and unknown fields must be rejected.",
    "Schema compliance does not establish identity or authorization."
  ],
  "schemas": {
    "memory.hold": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "why_remember": {
          "type": "string",
          "maxLength": 20000
        },
        "memory_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_confidence": {
          "enum": [
            "exact",
            "inferred",
            "unknown"
          ]
        },
        "occurred_start": {
          "anyOf": [
            {
              "$ref": "#/$defs/dt"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred_end": {
          "anyOf": [
            {
              "$ref": "#/$defs/dt"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/raw_ref"
          },
          "maxItems": 50
        },
        "raw_pending": {
          "type": "boolean"
        },
        "source_excerpt": {
          "type": "string",
          "maxLength": 100000
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          },
          "maxItems": 100
        },
        "emotions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/emotion"
          },
          "maxItems": 30
        },
        "sphere": {
          "enum": [
            "us",
            "life",
            "work"
          ]
        }
      },
      "required": [
        "text",
        "memory_date",
        "date_confidence",
        "raw_pending"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:mariposa:input:memory.hold:v1",
      "$defs": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "dt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "tag": {
          "type": "object",
          "properties": {
            "namespace": {
              "enum": [
                "topic",
                "project",
                "person",
                "free"
              ]
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "namespace",
            "tag"
          ],
          "additionalProperties": false
        },
        "emotion": {
          "type": "object",
          "properties": {
            "whose": {
              "enum": [
                "jiaming",
                "qiaosheng"
              ]
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "note": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "whose",
            "tag"
          ],
          "additionalProperties": false
        },
        "raw_ref": {
          "type": "object",
          "properties": {
            "conversation_id": {
              "$ref": "#/$defs/id"
            },
            "start_message_id": {
              "$ref": "#/$defs/id"
            },
            "end_message_id": {
              "$ref": "#/$defs/id"
            },
            "source_hash": {
              "$ref": "#/$defs/hash"
            }
          },
          "required": [
            "conversation_id",
            "start_message_id",
            "end_message_id",
            "source_hash"
          ],
          "additionalProperties": false
        }
      }
    },
