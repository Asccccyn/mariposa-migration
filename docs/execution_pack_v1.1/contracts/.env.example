# mariposa implementation configuration template — not a working deployment.
# All values below are defaults from the engineering specification, not inspected live values.
# GLM must implement validation, document overrides, and never print secrets.
APP_NAME=mariposa
APP_ENV=development
MARIPOSA_HOME=D:/mariposa
FORMAL_DB_PATH=runtime/formal/mariposa.sqlite3
WORKSPACE_DB_PATH=runtime/workspace/workspace.sqlite3
OBJECTS_DIR=runtime/objects
RELATIONSHIP_TIMEZONE=Asia/Shanghai
HTTP_BIND=127.0.0.1
HTTP_PORT=18780
WEB_DEV_PORT=5178
PUBLIC_BASE_URL=
# Do not configure or modify Cloudflare during ordinary development.

FORGET_IDLE_DAYS=30
FORGET_SCHEDULE_ENABLED=false
FORGET_REJECT_COOLDOWN_DAYS=30
FORGET_SCAN_BATCH_SIZE=20
CHAT_BOOT_RAW_MESSAGES=30
BOOT_MEMORY_DAYS=3
BOOT_DAY_WINDOW_MODE=calendar_days
PLAN_UPCOMING_DAYS=7
BOOT_SOFT_TOKEN_BUDGET=16000
BOOT_DIARY_FULLTEXT_COUNT=0
BOOT_HANDOFF_ENABLED=false
HANDOFF_ACTIVE_HOURS=72
QUOTE_SEMANTIC_AUTO_APPLY=true
EMOTION_RETRIEVAL_ENABLED=false
AUTO_WAKEUP_ENABLED=false

CC_PROVIDER=subscription_cli
CC_AUTH_MODE=subscription_cli
CC_PROFILE_DIR=runtime/cc_profile
CC_EXECUTABLE=
API_MODEL_PROVIDER_ENABLED=false
# Real CLI login is separate; no subscription token is supplied in this template.

EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
WORKER_PROVIDER=
WORKER_MODEL=
WORKER_BASE_URL=
WORKER_API_KEY=
# Worker or embedding credentials must not leak into the isolated CC runtime.

SIREN_BASE_URL=
SIREN_SERVICE_TOKEN=
SUPERPOSITION_BASE_URL=
SUPERPOSITION_SERVICE_TOKEN=
ZASHIDELE_BASE_URL=
ZASHIDELE_SERVICE_TOKEN=
LISTENING_PROVIDER=

AUTH_ISSUER=
AUTH_RESOURCE=
AUTH_SIGNING_KEY_FILE=
# Empty auth settings are NOT permission to run publicly without authentication.
# Do not add default admin passwords or a wildcard role-switching token.
