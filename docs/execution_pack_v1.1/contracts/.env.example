# mariposa implementation configuration template — not a working deployment.
# All values below are defaults from the engineering specification, not inspected live values.
# GLM must implement validation, document overrides, and never print secrets.
#
# 2026-10-05 审计同步：本模板此前停留在 v1.1 规格变量（MARIPOSA_HOME/
# FORGET_*/CC_*/SIREN_* 等已退役或从未实现），与 backend/mariposa/
# config.py 当前实现脱节。现按现行实现对齐；生产敏感值（密码/token）
# 永不入 git，凭证一律走 scripts/set_passwords.py（PBKDF2 落库）。

# 数据根：非 Windows 环境必填（fail-fast，不回退默认路径）
MARIPOSA_ROOT=

# 首次建库/换根时显式允许（完成后关闭；默认拒绝静默建库）
MARIPOSA_ALLOW_CREATE=0

APP_NAME=mariposa
APP_ENV=development

# HTTP（默认仅回环：本机 cloudflared 转发，不接受公网直连）
MARIPOSA_BIND=127.0.0.1
MARIPOSA_PORT=18780

# 时区（关系时间展示用；库内统一 UTC）
MARIPOSA_TZ=Asia/Shanghai

# 语义检索 provider（空 = 未配置；local_bge_zh / qwen3e4b）
MARIPOSA_SEMANTIC_PROVIDER=
MARIPOSA_QUOTE_SEMANTIC_AUTO_APPLY=true

# 召回运行时开关（§15.1：隔离验收后分项启用；judge 默认不联网）
MARIPOSA_RECALL_ENABLED=0
MARIPOSA_WORDS_RECALL_ENABLED=0
MARIPOSA_RAW_FALLBACK_ENABLED=0
MARIPOSA_RECALL_JUDGE_PROVIDER=disabled
MARIPOSA_RECALL_SESSION_TTL_HOURS=24

# 访问门禁（阈值加载即钳制为正整数）
MARIPOSA_GATE_AUTH_FAIL_THRESHOLD=5
MARIPOSA_GATE_LOCKOUT_BASE_SECONDS=900
MARIPOSA_GATE_LOCKOUT_MAX_SECONDS=86400
MARIPOSA_GATE_RATE_READ_PER_MIN=240
MARIPOSA_GATE_RATE_WRITE_PER_MIN=30
MARIPOSA_GATE_RATE_ANON_PER_MIN=60

# Source Layer 资源边界（超限结构化拒绝，不吃满内存/磁盘再失败）
MARIPOSA_SOURCE_MAX_ELEMENT_BYTES=67108864
MARIPOSA_SOURCE_MAX_ZIP_MEMBERS=20000
MARIPOSA_SOURCE_UPLOAD_MAX_BYTES=2147483648
MARIPOSA_SOURCE_MD_MAX_BYTES=536870912
MARIPOSA_SOURCE_IMPORT_LEASE_MINUTES=120
MARIPOSA_SOURCE_LIVE_MAX_MESSAGES=50
MARIPOSA_SOURCE_LIVE_MAX_JSON_BYTES=1048576

# Empty auth settings are NOT permission to run publicly without authentication.
# Do not add default admin passwords or a wildcard role-switching token.
