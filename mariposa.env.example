# mariposa 环境变量样板（程知行 2026-10-13 应她要求整理）
# ------------------------------------------------------------------
# 用法：复制需要改的键到生产启动脚本（~/Data/mariposa-secrets/start.sh
# 的 env 段）后 kickstart 重启；本地隔离实例直接 export。
# 秘密（key/密码）只写进 start.sh，不进 git、不经屏。
# ------------------------------------------------------------------

# ===== 服务 =====
# MARIPOSA_ROOT=/path/to/data          # 数据根（非 Windows 必填）
# MARIPOSA_BIND=127.0.0.1
# MARIPOSA_PORT=18780

# ===== 召回判断（后台页只留开关；provider/模型在这里配）=====
# 判断 provider：disabled | typesafe_jev | codex_sdk
# MARIPOSA_RECALL_JUDGE_PROVIDER=typesafe_jev
# 判断模型 ID（留空沿用 provider 默认）
# MARIPOSA_RECALL_JUDGE_MODEL_ID=
# MARIPOSA_RECALL_JUDGE_TIMEOUT_MS=5000

# ===== Jev（typesafe_jev）=====
# MARIPOSA_TYPESAFE_API_KEY=           # 必填（或 TYPESAFE_API_KEY）
# MARIPOSA_TYPESAFE_BASE_URL=          # 自部署端点（或 TYPESAFE_BASE_URL）
# MARIPOSA_TYPESAFE_ALLOWED_DATA=      # 数据 profile 白名单（provider 报错时看提示）

# ===== Codex SDK（codex_sdk）=====
# MARIPOSA_CODEX_API_KEY=              # 或 OPENAI_API_KEY
# MARIPOSA_CODEX_LIVE_ENABLED=1        # live 总开关（不开=blocked）
# MARIPOSA_CODEX_ALLOWED_DATA=

# ===== 语义向量（本地模型）=====
# MARIPOSA_SEMANTIC_PROVIDER=          # 留空=不配置（关键词检索照常工作）
#                                     # 配置后后台页显示"已配置"，预热用
#                                     # maintenance.semantic.warmup

# ===== 我们的话专项检索（words 通道）=====
# MARIPOSA_WORDS_RECALL_ENABLED=1      # 默认关

# ===== 原文上传上限（字节）=====
# MARIPOSA_SOURCE_UPLOAD_MAX_BYTES=
